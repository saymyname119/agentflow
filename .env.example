# Copy to .env for Docker Compose. Native CLI users export these variables.
# Generate four DIFFERENT secrets with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace_with_random_hex
WEBHOOK_SECRET=replace_with_random_secret_at_least_32_characters
OPERATOR_TOKEN=replace_with_different_random_secret_at_least_32_characters
REVIEWER_TOKENS={"your-github-login":"replace_with_a_third_random_secret_at_least_32_characters"}
ALLOWED_REPOSITORIES=your-login/your-repository
GITHUB_TOKEN=
# Optional: explicit reviewer publication requires Pull requests write permission.
GITHUB_WRITE_ENABLED=false
POLICY_FILE=policy.json
# Optional external audit: enabling it requires a completed, acknowledged audit before approval.
# Only enable for repositories whose code you are authorized to send to OpenAI.
LLM_AUDIT_ENABLED=false
OPENAI_API_KEY=
# Set an accessible Responses API model with structured-output support; no model is assumed.
LLM_MODEL=
